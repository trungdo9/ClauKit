# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# package manager
package-lock.json
yarn.lock
pnpm-lock.yaml

# semantic-release
.nyc_output

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# flutter
.dart_tool
build
GoogleService-Info.plist

repomix-output.xml
.serena/cache
plans/**/*
!plans/**/
!plans/**/plan.md
!plans/*/phase-*.md
!plans/**/STATE.md
# Reports are linked from plan.md — an ignored report is a 404 in the PR body.
!plans/**/reports/*.md
# …except the two that a script regenerates from git on demand.
plans/**/reports/review-package-*.md
plans/**/reports/*-brief-*.md
screenshots/*
docs/screenshots/*
docs/journals/*
docs/research/*
logs.txt
test-ck
__pycache__
prompt.md

# Gemini CLI settings (symlink to .claude/.mcp.json)
.gemini/settings.json

# ClauKit concurrency substrate (per-worktree file-claim registry, T1.2b)
.claude/.ck-file-claims.jsonl
.claude/.ck-tail-approved
# ClauKit smoke-gate cache (per-base-commit test results, T1.6/R8)
.claude/.ck-smoke-cache.json

# `.claude/skills` is a symlink (junction on Windows) to ./skills, recreated
# per-platform on checkout — untracked deliberately since 363c416. Ignored here
# and NOT in `.claude/.gitignore`, which ships with every kit: the installer
# dereferences the symlink, so a consumer's `.claude/skills/` is real files they
# may well want in their own history.
/.claude/skills

# Security scan output — enumerates exploitable paths; never commit one.
# `/ck:security` writes the report, `.security-tmp/` is its LARGE-mode scratch.
security-reports/
.security-tmp/
